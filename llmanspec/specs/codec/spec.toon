kind: llman.sdd.spec
name: codec
purpose: "编解码：JSON-RPC 与 TOON/passthrough 输出。"
valid_scope[2]: src/codec/,tests/
requirements[4]{req_id,title,statement}:
  r8,"JSON-RPC 编解码","系统 MUST 编解码 JSON-RPC 2.0 DAP 消息。"
  r16,TOON 输出,"系统 MUST 提供 value_to_toon：将任意 JSON Value 编码为 TOON 文本，且 MUST 使用 toon-format（encode_default）实现，以保证与官方 TOON 规范一致。"
  r24,Passthrough,output_format=passthrough 时 Proxy MUST NOT 改写消息体。
  r58,TOON 基准列,"系统 MUST 在 bench-report 示例中同时报告压缩 JSON 相对原始与 TOON 相对原始的 token 节省（cl100k_base），以便与 README 压缩效果表对齐。"
scenarios[4]{req_id,id,given,when,then,feature}:
  r8,roundtrip,合法 DAP JSON 对象,encode/decode,字段语义保持,false
  r16,"toon-format-crate",含嵌套对象与表格数组的 Value,调用 value_to_toon,得到非空 TOON 字符串,true
  r24,"passthrough-raw",passthrough 模式,转发任意 ServerToClient 帧,字节语义与输入一致,false
  r58,"bench-toon-column",fixtures/bench 用例,"运行 examples/bench-report",输出含紧凑与 TOON 两列节省,true
