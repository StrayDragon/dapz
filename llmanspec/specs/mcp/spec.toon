kind: llman.sdd.spec
name: mcp
purpose: "MCP 服务器：Tier-0 调试工具与 DapPool 会话复用。"
valid_scope[2]: src/mcp/,tests/
requirements[8]{req_id,title,statement}:
  r10,MCP 双模式,"系统 MUST 在 feature mcp 下实现 MCP 服务器（daemon 默认或 --no-daemon 进程内）并暴露 Tier-0 调试工具。"
  r18,工具集合,"系统 MUST 注册 Tier-0 工具集以及 debug_attach、get_source、get_exception、set_exception_breakpoints、send_raw。"
  r26,会话池,系统 MUST 通过 DapPool 按 key 复用 DapSession。
  r33,默认 TOON,MCP 观测类工具输出 MUST 默认使用 TOON（或配置的紧凑格式）。
  r37,"Tier-1 异常工具",系统 MUST 注册 debug_attach、get_source、get_exception、set_exception_breakpoints，并保留 send_raw。
  r52,MCP 默认 daemon,"系统 MUST 默认使 dapz mcp 经 DaemonMcpServer 连接或自动启动 dapz daemon；MUST 提供 --no-daemon 回退进程内 McpServer。"
  r64,DAP 规范优先,系统 MUST 使 DapSession 的 initialize/launch 默认仅使用 DAP 规范通用字段；适配器扩展（如 debugpy console）MUST 仅在已识别的 AdapterKind 下启用，并在文档中标明兼容范围。
  r65,threadId 解析,当调用方未提供 threadId 时，系统 MUST 通过 threads 请求解析线程 id，MUST NOT 盲默认 threadId=1。
scenarios[10]{req_id,id,given,when,then,feature}:
  r10,"mcp-start",启用 features mcp,运行 dapz mcp,进程以 MCP stdio 服务运行,true
  r18,"tool-count-21",list_tools,计数,恰好 21 个工具,true
  r26,"pool-reuse",相同 pool key 两次 debug_launch,获取会话,复用同一后端会话策略成立,false
  r33,"stack-toon",get_stack 成功,返回内容,为 TOON 文本而非冗长 JSON,false
  r37,"has-exception-tools",MCP list_tools,扫描名称,含 get_exception 与 debug_attach,true
  r52,"mcp-daemon-default",features mcp,"运行 dapz mcp 无 --no-daemon",工具调用经 daemon socket,true
  r52,"mcp-no-daemon","传 --no-daemon",运行 dapz mcp,使用进程内 DapPool,true
  r64,"generic-no-console",backend 不含 debugpy,launch_program,launch 参数无 console 字段,true
  r64,"debugpy-console",backend 含 debugpy,launch_program,launch 含 console=internalConsole,true
  r65,"resolve-tid",threads 返回 id=42 且未传 threadId,get_stack,请求使用 threadId=42,true
