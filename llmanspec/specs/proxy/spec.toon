kind: llman.sdd.spec
name: proxy
purpose: 代理核心：DAP 会话转发、拦截链与 CLI 子命令。
valid_scope[3]: src/proxy.rs,src/main.rs,tests/
requirements[5]{req_id,title,statement}:
  r12,透明代理,系统 MUST 提供 Proxy 在 Agent 与 DAP adapter 之间透明转发请求与响应。
  r20,拦截链,Proxy MUST 对 Server→Client 消息应用 InterceptorChain（capping + compressors）；Client→Server MUST 原样转发。
  r28,CLI 子命令,CLI MUST 提供 dapz proxy（及别名 p）与 dapz mcp 子命令，且 proxy 子命令 MUST 暴露 metrics 与 transport 旋钮。
  r35,配置驱动输出,系统 MUST 支持 OutputFormat：json、toon、passthrough。
  r60,Proxy CLI 旋钮,"系统 MUST 使 dapz proxy 支持 --metrics 与 --transport（stdio 或 tcp:// 或 ws://）；--transport 默认 stdio；--output 默认 MUST 保持 json（IDE 友好），与 MCP/SDK 的 TOON 默认区分。"
scenarios[6]{req_id,id,given,when,then,feature}:
  r12,"proxy-start",配置 backend 命令,启动 Proxy,建立与 adapter 的会话,false
  r20,"server-to-client-only",Client→Server 请求与 Server→Client 响应,经 Proxy,仅后者进入拦截链,false
  r28,"help-subcommands","运行 dapz --help",查看子命令,列出 proxy 与 mcp,true
  r35,"output-formats",Config.output_format 分别为 json/toon/passthrough,转发响应,按格式编码或不改写,false
  r60,"proxy-metrics-flag","传 --metrics",构建拦截链,MeteredInterceptor 启用,true
  r60,"proxy-transport-help","运行 dapz proxy --help",查看选项,"列出 --transport 与 --metrics",true
