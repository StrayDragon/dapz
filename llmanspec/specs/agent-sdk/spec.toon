kind: llman.sdd.spec
name: "agent-sdk"
purpose: Agent SDK：AgentHandle Tier-0 API（AgentPool 为后续 change）。
valid_scope[2]: src/agent_sdk/,tests/
requirements[4]{req_id,title,statement}:
  r7,AgentHandle,"系统 MUST 在 feature agent-sdk 下提供 AgentHandle 管理单个 DAP 会话。"
  r15,"Tier-0 方法",AgentHandle MUST 提供 launch、set_breakpoints、continue_、step_*、pause、get_threads、get_stack、get_scopes、get_variables、evaluate、drain_output、wait_stopped、disconnect、terminate、send_raw。
  r23,TOON 返回,观测类方法 MUST 返回 TOON 字符串（或等价紧凑表示）。
  r31,无专用 attach API,AgentHandle MUST NOT 提供 attach/source/exceptionInfo 专用方法（可用 send_raw）。
scenarios[4]{req_id,id,given,when,then,feature}:
  r7,"agent-start","AgentHandle::builder 配置 backend",调用 start,返回可用句柄,false
  r15,"debug-loop",fixture 脚本与断点,launch→get_stack→evaluate→disconnect,各步骤成功,false
  r23,"stack-toon",get_stack,成功返回,内容为 TOON,false
  r31,"no-attach-method",查阅 AgentHandle API,检查公开方法,无 attach/get_source/get_exception,false
