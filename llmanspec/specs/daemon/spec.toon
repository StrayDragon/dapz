kind: llman.sdd.spec
name: daemon
purpose: "长驻 DAP daemon：按 project cwd 的 Unix socket 会话池（非 LSP workspace/docs）。"
valid_scope[2]: src/,tests/
requirements[5]{req_id,title,statement}:
  r48,DAP daemon,"系统 MUST 在 feature mcp 下提供长驻 daemon，通过 Unix socket NDJSON JSON-RPC 管理 DAP adapter 会话。"
  r49,socket 按 cwd,daemon socket 路径 MUST 由规范化 project cwd 派生（~/.cache/dapz/），不得使用 LSP workspace roots 模型。
  r50,dap RPC 扩展,daemon MUST 支持 dap/spawn、dap/request、dap/wait_event、dap/invoke、dap/remove、daemon/status、daemon/shutdown。
  r51,会话 key,"daemon 会话 MUST 使用 backend[+cwd] pool_key（与 DapPool 一致），不得按 LSP language id 建会话。"
  r53,dap invoke remove,daemon MUST 支持 dap/invoke（高阶 DapSession 操作）与 dap/remove；dap/spawn MUST 支持 replace 以重建会话。
scenarios[5]{req_id,id,given,when,then,feature}:
  r48,"cli-daemon",features mcp,运行 dapz daemon,进程监听 Unix socket,true
  r49,"stable-socket",同一 cwd 两种路径拼写,计算 socket_path,得到相同路径,true
  r50,"rpc-has-invoke",daemon 协议,检查方法表,含 dap/invoke 与 dap/remove,true
  r51,"pool-key",spawn backend+cwd,创建会话,"key 等于 pool_key(backend,cwd)",true
  r53,"invoke-launch",已 spawn 的 session,dap/invoke launch_program,返回 stopped 体,true