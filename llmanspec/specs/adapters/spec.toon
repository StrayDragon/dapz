kind: llman.sdd.spec
name: adapters
purpose: 适配器发现：扩展名查找与 resolve_tool 包管理器默认路径。
valid_scope[3]: src/adapters.rs,"scripts/check-env.sh",tests/
requirements[5]{req_id,title,statement}:
  r1,扩展名多后端,系统 MUST 按文件扩展名解析 AdapterInfo（py→debugpy；c/cpp/rs→lldb）。
  r2,resolve_tool,resolve_tool MUST 按 PATH → ~/.local/bin → cargo bin → go bin → npm/bun 默认目录顺序查找可执行文件。
  r3,debugpy 发现,"resolve_python_debug_adapter MUST 在 resolve_tool(debugpy-adapter) 之后尝试 uv tools 默认布局与 python -m debugpy.adapter。"
  r4,可测上下文,DiscoveryContext MUST 支持注入 HOME/XDG/CARGO/GOPATH/PATH 以便单测不依赖进程全局环境。
  r56,lldb 发现,"系统 MUST 提供 resolve_lldb_debug_adapter，按 lldb-dap 再 lldb-vscode 顺序经 resolve_tool 查找。"
scenarios[5]{req_id,id,given,when,then,feature}:
  r1,"lookup-rs",扩展名 rs,lookup_by_extension,返回 language=rust 且 backend 含 lldb,true
  r2,"user-bin-without-path",PATH 为空且 ~/.local/bin/mytool 可执行,resolve_tool_in,返回该路径,false
  r3,"uv-tools-layout","仅存在 XDG uv/tools/debugpy/bin/debugpy-adapter",resolve_python_debug_adapter_in,返回该 adapter 路径,false
  r4,"mock-home",临时目录作为 HOME,单元测试,不修改真实环境变量即可断言发现结果,false
  r56,"prefer-lldb-dap","PATH 同时有 lldb-dap 与 lldb-vscode",resolve_lldb_debug_adapter_in,"返回 lldb-dap",true
