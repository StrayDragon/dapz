kind: llman.sdd.spec
name: transport
purpose: "传输层：Content-Length 分帧与 stdio/tcp。"
valid_scope[2]: src/transport/,tests/
requirements[5]{req_id,title,statement}:
  r14,Transport trait,系统 MUST 定义 Transport trait 包含异步 receive 与 send。
  r22,"Content-Length 分帧","所有传输层 MUST 处理 Content-Length 分帧，且读取路径 cancel-safe。"
  r30,多协议支持,"系统 MUST 支持 StdioTransport 与 TcpTransport；dapz proxy --transport MUST 能选择 stdio（默认）或 tcp://host:port，且 MUST NOT 声称支持 WebSocket。"
  r36,"Content-Length 上限",分帧读取 MUST 拒绝超过约定上限的 body，避免无界分配。
  r62,无 WebSocket 传输,"系统 MUST NOT 提供 WsTransport 或 transport-websocket feature；dapz proxy --transport MUST 仅接受 stdio 与 tcp://。"
scenarios[5]{req_id,id,given,when,then,feature}:
  r14,"trait-surface",Transport 实现,调用 receive/send,完成一帧读写,false
  r22,"cancel-safe-frame",半包到达后任务取消再恢复,继续 read_frame,不丢失已读字节,false
  r30,"cli-transport-tcp","--transport tcp://127.0.0.1:1234",启动 proxy,使用 TcpTransport,true
  r36,"reject-oversized","Content-Length 过大",read_frame,返回错误且不分配完整 body,false
  r62,"reject-ws","--transport ws://example",启动 proxy,报错且提示仅 stdio/tcp,true
