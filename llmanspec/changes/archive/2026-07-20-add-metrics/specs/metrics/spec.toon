kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,r44,MeteredInterceptor,"系统 MUST 提供 MeteredInterceptor，在启用时记录 DAP 消息输入/输出字节、延迟与失败数。",null,null,null
  add_requirement,r45,默认关闭,"Metrics 默认 MUST 关闭；仅当 DAPZ_METRICS 显式启用时 proxy 拦截链才包装计量（零开销默认路径）。",null,null,null
  add_requirement,r46,压缩比快照,"MetricsSnapshot MUST 提供 compression_ratio 与 summary，便于 tracing 观测 DAP 压缩效果。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  r44,"record-sizes",启用的 MeteredInterceptor,处理一条 ServerToClient DAP 消息,messages_processed 增 1 且字节计数增加
  r45,"disabled-zero",未 enable 的包装器,处理消息,计数保持 0
  r46,"ratio",input=200 output=50,调用 compression_ratio,返回约 0.75
