kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r35,配置驱动输出,"系统 MUST 使 Proxy 按 OutputFormat 分流：passthrough MUST 原样转发且 MUST NOT 进入拦截链；json MUST 经 InterceptorChain 后输出压缩 DAP JSON 帧；toon MUST 经 InterceptorChain 后将 body 编码为 {format:toon,text} 包装（保留 DAP 信封字段）。编码失败 MUST fail-open 原始帧。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  r35,"passthrough-raw",output_format=passthrough,转发 Server→Client output 事件,输出字节与输入一致且未经压缩
  r35,"json-compressed",output_format=json 且启用 output 压缩,转发含 ANSI 的 output 事件,仍为 DAP JSON 帧且 body 已压缩
  r35,"toon-wrapped",output_format=toon,转发可压缩 response/event,body.format=toon 且 body.text 为非空 TOON
