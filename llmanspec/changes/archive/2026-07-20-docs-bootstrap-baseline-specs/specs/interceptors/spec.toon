kind: llman.sdd.delta
ops[6]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,Capping,系统 MUST 提供 CappingInterceptor 限制 output/stackTrace/variables 条目规模。,null,null,null
  add_requirement,r2,OutputCompressor,系统 MUST 压缩 output 事件（重复行折叠、类别缩写等）。,null,null,null
  add_requirement,r3,StackTraceCompressor,系统 MUST 压缩 stackTrace 响应（路径缩写、合成帧过滤等）。,null,null,null
  add_requirement,r4,VariablesCompressor,系统 MUST 压缩 variables 响应（长值截断、类型前缀等）。,null,null,null
  add_requirement,r5,EvaluateCompressor,系统 MUST 压缩 evaluate 响应（结果截断、去 memoryReference 等）。,null,null,null
  add_requirement,r6,ScopesCompressor,系统 MUST 压缩 scopes 响应（去掉位置噪声并保留 variablesReference）。,null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  r1,"cap-frames",超长 stackTrace,经 CappingInterceptor,帧数不超过配置上限
  r2,"fold-output",重复 stdout 行,经 OutputCompressor,折叠为带计数的紧凑形式
  r3,"abbrev-path",深路径 stack frame,经 StackTraceCompressor,路径缩短且可定位
  r4,"truncate-value",超长变量值,经 VariablesCompressor,截断到 max_value_length
  r5,"truncate-eval",超长 evaluate result,经 EvaluateCompressor,截断到 max_evaluate_length
  r6,"scopes-keep-ref",含 source/line 的 scopes,经 ScopesCompressor,保留 variablesReference 且去掉位置噪声
