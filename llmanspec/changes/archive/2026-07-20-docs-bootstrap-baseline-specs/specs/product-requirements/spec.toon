kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,AI 友好 DAP 代理,系统 MUST 构建对 AI Coding Agent 友好的 DAP 压缩代理层。,null,null,null
  add_requirement,r2,Token 压缩,系统 MUST 对 Server→Client 方向的 DAP 消息进行 Token 敏感压缩；压缩失败时 MUST 透传原始消息。,null,null,null
  add_requirement,r3,三模态支持,"系统 MUST 支持 Library、Proxy CLI、MCP 三种使用模式（daemon 不在 v0.1 范围）。",null,null,null
  add_requirement,r4,Tier-0 收紧,"v0.1 MUST 以 launch→breakpoints→stopped→stack/scopes/variables/evaluate→step→disconnect 为最小闭环；attach/source/exceptionInfo MUST NOT 提供专用 MCP/SDK API。",null,null,null
  add_requirement,r5,DAP 兼容透传,系统 MUST 对非拦截白名单的 DAP 消息保持透传兼容（body 语义不变）。,null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r1,"agent-debug-loop",Agent 使用 dapz MCP 或 Agent SDK,执行 Tier-0 调试循环,可观测 stack/vars/output 并完成 disconnect
  r2,"compress-or-passthrough",拦截器内部错误,处理 ServerToClient 消息,转发原始消息且会话不崩溃
  r3,"three-modes","cargo build / dapz proxy / dapz mcp",分别启用,三种模式均可工作
  r4,"no-exception-api",list_tools,检查工具名,不含 debug_attach/get_source/get_exception/set_exception_breakpoints
  r5,"tier1-passthrough",未压缩的 DAP 响应,经 Proxy 转发,body 与后端一致
