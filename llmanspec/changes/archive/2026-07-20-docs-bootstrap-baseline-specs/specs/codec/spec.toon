kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,JSON-RPC 编解码,系统 MUST 编解码 JSON-RPC 2.0 DAP 消息。,null,null,null
  add_requirement,r2,TOON 输出,"系统 MUST 提供 value_to_toon：将任意 JSON Value 编码为 TOON 文本。",null,null,null
  add_requirement,r3,Passthrough,"output_format=passthrough 时 Proxy MUST NOT 改写消息体。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  r1,"roundtrip",合法 DAP JSON 对象,encode/decode,字段语义保持
  r2,"toon-value",含嵌套对象的 Value,调用 value_to_toon,得到非空 TOON 字符串
  r3,"passthrough-raw",passthrough 模式,转发任意 ServerToClient 帧,字节语义与输入一致
