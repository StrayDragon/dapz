kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,AgentHandle,系统 MUST 在 feature agent-sdk 下提供 AgentHandle 管理单个 DAP 会话。,null,null,null
  add_requirement,r2,Tier-0 方法,"AgentHandle MUST 提供 launch、set_breakpoints、continue_、step_*、pause、get_threads、get_stack、get_scopes、get_variables、evaluate、drain_output、wait_stopped、disconnect、terminate、send_raw。",null,null,null
  add_requirement,r3,TOON 返回,观测类方法 MUST 返回 TOON 字符串（或等价紧凑表示）。,null,null,null
  add_requirement,r4,无专用 attach API,"AgentHandle MUST NOT 提供 attach/source/exceptionInfo 专用方法（可用 send_raw）。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r1,"agent-start",AgentHandle::builder 配置 backend,调用 start,返回可用句柄
  r2,"debug-loop",fixture 脚本与断点,launch→get_stack→evaluate→disconnect,各步骤成功
  r3,"stack-toon",get_stack,成功返回,内容为 TOON
  r4,"no-attach-method",查阅 AgentHandle API,检查公开方法,无 attach/get_source/get_exception
