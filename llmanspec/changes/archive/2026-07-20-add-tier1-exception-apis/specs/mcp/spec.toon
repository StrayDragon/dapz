kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r37,Tier-1 异常工具,"系统 MUST 注册 debug_attach、get_source、get_exception、set_exception_breakpoints，并保留 send_raw。",null,null,null
  modify_requirement,r18,工具集合,"系统 MUST 注册 Tier-0 工具集以及 debug_attach、get_source、get_exception、set_exception_breakpoints、send_raw。",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  r37,"has-exception-tools",MCP list_tools,扫描名称,含 get_exception 与 debug_attach
  r18,"tool-count-21",list_tools,计数,恰好 21 个工具
